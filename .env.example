# ── Stripe ────────────────────────────────────────────────────────────────────
# Test mode key (starts with sk_test_)
# Required for checkout functionality
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Your deployed URL (no trailing slash)
# Required for CORS and Stripe success/cancel URLs
VITE_APP_URL=https://stripe-dev.vercel.app

# Optional: GitHub personal access token (avoids unauthenticated rate limits)
# Required scopes: public_repo, read:user, read:org
GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE

# ── Optional: webhook secret (for verifying Stripe webhook signatures) ─────────
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
